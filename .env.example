# ===== LLM API Key (ONE key for everything — free) =====
# Get from: https://build.nvidia.com/settings/api-keys (no credit card needed)
# This single key gives you access to Nemotron, Llama and 100+ models
NVIDIA_API_KEY=

# ===== API Base URL =====
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1


# ===== Where orders actually go =====
# paper  — simulated fills stored locally. No broker, no money. Safe default.
# broker — real orders on your MT5 account through the MetaApi cloud bridge.
#          Works on macOS, Linux and Windows. Use this with Trading.com.
# live   — the MetaTrader 5 terminal on this machine. Windows only.
TRADING_MODE=paper

DAILY_DRAWDOWN_LIMIT=1000.0
MAX_POSITION_SIZE=5.0
MAX_CONCURRENT_TRADES=5


# ===== Broker bridge: Trading.com (or any MT5 broker) on any OS =====
# The official MetaTrader5 Python package is Windows-only, so on a Mac the
# orders go through MetaApi instead: it runs the MT5 terminal in the cloud and
# exposes it over HTTPS. One account is free.
#
# Easiest path: leave these blank and paste them into the AUTOPILOT tab in the
# app instead — the "BROKER CONNECTION" form saves them here for you and tests
# the connection on the spot.
#
# Or fill them by hand, once:
#   1. Open a Trading.com (or any MT5) demo account. Note the MT5 login,
#      password and the server name (e.g. MetaQuotes-Demo or Tradingcom-Demo).
#   2. Sign up at https://app.metaapi.cloud and add that MT5 login.
#      Copy the account id (a UUID) it shows you.
#   3. Generate a token at https://app.metaapi.cloud/token, note the region.
#   4. Fill the values below, set TRADING_MODE=broker, then check
#      http://localhost:8000/broker/status before enabling trading.
#
# Note: MetaApi is a paid cloud service (~$0.0126/hr while the account is
# deployed; a few dollars covers plenty of demo testing). Undeploy the account
# from their dashboard when idle to pause billing.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
# Region your account is deployed in, shown on the token page.
METAAPI_REGION=new-york

# Master switch for sending orders. Reads (balance, prices, positions) work
# without it, so the connection can be proven safe first.
BROKER_TRADING_ENABLED=false

BROKER_TIMEOUT_SEC=20

# Only needed when your broker names an instrument unexpectedly. Blank means
# auto-detect. Check GET /broker/symbols?search=nas to find the right name.
# BROKER_SYMBOL_NAS100=USTEC
# BROKER_SYMBOL_XAUUSD=GOLD
# BROKER_SYMBOL_EURUSD=
# BROKER_SYMBOL_GBPUSD=


# ===== MT5 terminal (only for TRADING_MODE=live, Windows only) =====
# Leave empty to use the account already logged in to the MT5 terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=


# ===== Trading style =====
# Drives candle timeframe, how fresh a price must be, how far an entry may sit
# from the market, and which models are used. Change it in the AUTOPILOT tab or
# here. scalp = 1m bars / 10s max price age, day = 15m / 90s, swing = 1h / 600s.
TRADING_STYLE=day

# Prefer the broker's live bid/ask over the free public feed wherever possible.
# Applies in paper mode too, so practice happens against the real market.
PREFER_BROKER_QUOTES=true


# ===== Entry rules =====
# true  — entries must come from the deterministic rules in trading/strategy.py,
#         with the LLM only reviewing. Most polls correctly find no setup.
# false — ask a model for a trade, which produces one whether or not a setup
#         exists. Not recommended: that is how random entries happen.
REQUIRE_RULE_SETUP=true

# Fraction of account balance risked per trade. Fixed-fractional sizing shrinks
# the position automatically during a losing run. 0.005 = 0.5%.
RISK_PER_TRADE_PCT=0.005


# ===== Trade management (how a winner is kept) =====
# Move the stop to entry once the trade is this many risk-units in profit. From
# then on the trade cannot lose.
BREAK_EVEN_R=1.0
# Beyond this, trail the stop instead of leaving it at entry.
TRAIL_START_R=1.5
# Trailing distance as a multiple of ATR. Too tight and noise closes the trade.
TRAIL_ATR_MULT=1.5
# Close a position that has gone nowhere for this many bars. 0 disables.
MAX_BARS_IN_TRADE=24


# ===== News blackout =====
# Refuses to open a position around high-impact releases (NFP, CPI, FOMC, ECB,
# BoE), when spreads widen and stops slip. Built from fixed schedules, so it
# cannot fail silently. Leave enabled.
NEWS_BLACKOUT_ENABLED=true
NEWS_BLACKOUT_BEFORE_MIN=30
NEWS_BLACKOUT_AFTER_MIN=15
# Optional extra JSON calendar feed. Blank uses the built-in schedule only.
NEWS_API_URL=


# ===== Learning from outcomes =====
# Shows each agent its own win rate, P&L and losing streaks before it proposes
# again. In-context only — no model weights are changed.
LEARNING_ENABLED=true
LEARNING_LOOKBACK=20


# ===== Autopilot: unattended trading =====
# Off unless you turn it on. Nothing trades on its own by default.
AUTOPILOT_ENABLED=false

# Seconds between market scans. 300 stays well inside free API limits.
AUTOPILOT_INTERVAL_SEC=300

AUTOPILOT_SYMBOLS=EUR/USD,XAU/USD,GBP/USD,NAS100

# Throughput caps. Hitting either parks the loop until the window rolls over.
AUTOPILOT_MAX_TRADES_PER_HOUR=2
AUTOPILOT_MAX_TRADES_PER_DAY=6

# Hard ceiling on size, whatever an agent asks for.
AUTOPILOT_MAX_SIZE=0.10

# Minimum reward:risk worth taking while nobody is watching.
AUTOPILOT_MIN_RR=1.5

# true  — queue proposals for a human APPROVE click (recommended)
# false — place them without asking
AUTOPILOT_REQUIRE_APPROVAL=true

# Second lock: the autopilot will not send orders to a real account (broker or
# live mode) unless this is true, even when the above is false.
AUTOPILOT_ALLOW_LIVE=false

# Realised loss in USD that trips the kill switch and stops for the day.
AUTOPILOT_HALT_DRAWDOWN=500.0


# ===== Overnight notifications (optional) =====
# Message @BotFather on Telegram to create a bot, then send it a message and
# read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ===== Database =====
DB_PATH=./data/app.db

# ===== Server =====
HOST=0.0.0.0
PORT=8000
