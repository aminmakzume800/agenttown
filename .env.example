# ===== LLM API Key (ONE key for everything — free) =====
# Get from: https://build.nvidia.com/settings/api-keys (no credit card needed)
# This single key gives you access to DeepSeek, Llama, Nemotron, CodeLlama and 100+ models
NVIDIA_API_KEY=

# ===== API Base URL =====
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ===== Trading Configuration =====
TRADING_MODE=paper
# Change to "live" to enable real MT5 trading (requires MT5 installed + demo account)
# TRADING_MODE=live
DAILY_DRAWDOWN_LIMIT=1000.0
MAX_POSITION_SIZE=5.0
MAX_CONCURRENT_TRADES=5

# ===== MT5 Configuration (only needed if TRADING_MODE=live) =====
# Leave empty to use the account already logged in to MT5 terminal
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ===== Database =====
DB_PATH=./data/app.db

# ===== Server =====
HOST=0.0.0.0
PORT=8000
